{
  /* The tests, the local-backend run and the join page's Worker; convex/tsconfig.json covers the functions. */
  "compilerOptions": {
    "strict": true,
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "target": "ESNext",
    "lib": ["ES2023", "dom"],
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "types": ["node", "vite/client"]
  },
  "include": ["tests/**/*", "local-backend/**/*", "worker/src/**/*", "vitest.config.ts", "vitest.local-backend.config.ts"]
}
