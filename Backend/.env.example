# The Convex deployment's environment variables, with placeholders only (Backend/SETUP.md says where each comes from).
# Set them on the deployment with `npx convex env set NAME value` or in its dashboard. Never commit real values.

# Clerk (Backend/SETUP.md, step 3)
CLERK_JWT_ISSUER_DOMAIN=https://your-instance.clerk.accounts.dev
CLERK_SECRET_KEY=sk_test_REPLACE_ME
CLERK_WEBHOOK_SECRET=whsec_REPLACE_ME

# Cloudflare R2 (step 4)
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=immerse-pictures
R2_ACCESS_KEY_ID=REPLACE_ME
R2_SECRET_ACCESS_KEY=REPLACE_ME
R2_REGION=auto

# Apple's push notification service (step 5). APNS_PRIVATE_KEY is the .p8 file's text, with its line breaks kept or
# written as \n.
APNS_KEY_ID=REPLACE_ME
APNS_TEAM_ID=REPLACE_ME
APNS_TOPIC=com.immerse.FilmJournal
APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----"

# Group Films (step 5). JOIN_CODE_SECRET derives every Join Code; never change it once events exist.
JOIN_CODE_SECRET=REPLACE_ME_WITH_48_RANDOM_BYTES_BASE64
# The support relay for reports (step 5a): an endpoint the operator runs that forwards to the support address.
SUPPORT_REPORT_WEBHOOK_URL=https://relay.example.com/reports
SUPPORT_REPORT_WEBHOOK_SECRET=REPLACE_ME
# The join page's Worker (step 4a) proves itself to this deployment with this secret; the Worker holds the same value.
WEB_GATEWAY_SECRET=REPLACE_ME_WITH_48_RANDOM_BYTES_BASE64
# Everyone's once-ever free Rolls (the server's default is 3, the PRD's "about 3"), from the pricing decision (OC-5).
# FREE_ROLLS_EVERYONE=REPLACE_WITH_EVERYONES_FREE_ROLLS

# Buying Rolls and the subscriber's free Rolls (Stage 4; Backend/SETUP.md, step 10). Every number here is the pricing
# decision's (OC-5), still open: the placeholders are refused, so a copy of this file sells nothing and links no
# subscription.
APPLE_BUNDLE_ID=com.immerse.FilmJournal
APPLE_APP_APPLE_ID=REPLACE_WITH_THE_APPS_APPLE_ID
# Sandbox for a development deployment; Production,Sandbox for the production one, where App Review buys in the sandbox.
APPLE_ENVIRONMENTS=Sandbox
# App Store Connect's In-App Purchase key. APP_STORE_PRIVATE_KEY is the .p8 file's text, with its line breaks kept or
# written as \n.
APP_STORE_KEY_ID=REPLACE_ME
APP_STORE_ISSUER_ID=REPLACE_ME
APP_STORE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----"
# One "<product id>:<Rolls>" entry per Roll pack, separated by commas.
ROLL_PACKS=com.immerse.FilmJournal.rolls.REPLACE_WITH_PACK_NAME:REPLACE_WITH_ROLLS_IN_PACK
# The v1 subscription's monthly and yearly products (DEC-02).
SUBSCRIPTION_PRODUCT_IDS=REPLACE_WITH_MONTHLY_PRODUCT_ID,REPLACE_WITH_YEARLY_PRODUCT_ID
# A subscriber's larger once-ever free Rolls; unset or 0 gives none and links no subscription.
FREE_ROLLS_SUBSCRIBER=REPLACE_WITH_SUBSCRIBERS_FREE_ROLLS

# Only the tests set these, to point at local stand-ins; a real deployment leaves them unset.
# CLERK_API_URL=
# APNS_ORIGIN=
# APNS_CA_PEM=
# APPLE_ROOT_CA_PEM=
# APP_STORE_API_ORIGIN=
